{
  "name": "playwright-typescript-framework",
  "version": "0.1.0",
  "description": "An enterprise-grade Playwright automation framework built with TypeScript.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "type-check": "tsc --noEmit",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:staging": "cross-env TEST_ENV=staging playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sujithkumar0017/playwright-typescript-framework.git"
  },
  "keywords": [],
  "author": "Sujith Kumar",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sujithkumar0017/playwright-typescript-framework/issues"
  },
  "homepage": "https://github.com/sujithkumar0017/playwright-typescript-framework#readme",
  "devDependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/playwright": "^1.1.6",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  }
